AWS_REGION=ap-northeast-2
AWS_DEFAULT_REGION=
# Dashboard reads one road_segment snapshot object from S3 and scores from the API.
# e.g. s3://<reference-bucket>/normalized/road_segment/snapshot_date=YYYY-MM-DD/build_id=<id>/part-00000.parquet
DASHBOARD_ROAD_SEGMENT_S3_URI=
DASHBOARD_SERVING_API_URL=
DASHBOARD_VEHICLE_PROFILE_ID=0
# Keep this at or below serving_api.config.MAX_COMFORT_SCORE_BATCH_ITEMS.
DASHBOARD_BATCH_CHUNK_SIZE=1000
DASHBOARD_REQUEST_TIMEOUT_SECONDS=30
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_SENSOR_TOPIC=
KAFKA_STARTING_OFFSETS=
# EC2 Kafka의 EXTERNAL listener가 producer에게 알려줄 공개 IP 또는 DNS
KAFKA_EXTERNAL_HOST=
STREAM_TRIGGER_INTERVAL_SECONDS=
STREAM_BRONZE_OUTPUT_PATH=
STREAM_BRONZE_CHECKPOINT_LOCATION=
STREAM_SPARK_MASTER=
STREAM_MIN_OFFSETS_PER_TRIGGER=
STREAM_MAX_TRIGGER_DELAY=
STREAM_BRONZE_OUTPUT_PARTITIONS=
# standard_score_pipeline이 EMR Serverless Job Run에 넘길 설정(#292, ADR-0001).
# AIRFLOW_VAR_* 환경변수는 Airflow가 Variable로 자동 인식한다. entry point는
# batch-jobs의 EMR Serverless 커스텀 이미지가 준비되기 전까지 플레이스홀더다.
AIRFLOW_VAR_EMR_SERVERLESS_APPLICATION_ID=
AIRFLOW_VAR_EMR_SERVERLESS_EXECUTION_ROLE_ARN=
AIRFLOW_VAR_BATCH_JOBS_EMR_ENTRY_POINT=
AIRFLOW_VAR_CLEANSING_BRONZE_INPUT_PATH=
AIRFLOW_VAR_CLEANSING_QUARANTINE_OUTPUT_PATH=
AIRFLOW_VAR_HOURLY_SEGMENT_FEATURE_ROAD_SEGMENT_PATH=
AIRFLOW_VAR_HOURLY_SEGMENT_FEATURE_OUTPUT_PATH=
AIRFLOW_VAR_HOURLY_SEGMENT_FEATURE_ROAD_SNAPSHOT_DATE=
AIRFLOW_VAR_HOURLY_SEGMENT_FEATURE_VERSION=
AIRFLOW_VAR_HOURLY_COMFORT_INPUT_PATH=
AIRFLOW_VAR_HOURLY_COMFORT_OUTPUT_PATH=
AIRFLOW_VAR_HOURLY_COMFORT_REJECTED_OUTPUT_PATH=
AIRFLOW_VAR_STANDARD_COMFORT_SCORE_DATA_LAKE_URI=
AIRFLOW_VAR_STANDARD_COMFORT_SCORE_WINDOW_HOURS=
# 비우면 STANDARD_COMFORT_SCORE_DATA_LAKE_URI/gold/standard_segment_comfort_score를
# 기본값으로 쓴다(#265).
AIRFLOW_VAR_STANDARD_COMFORT_SCORE_GOLD_OUTPUT_URI=
# standard_score task의 driver_env로 넘어간다 — 주의: EMR Serverless Job Run
# 설정에 평문으로 남는 임시 방편이다(#292 논의, Secrets Manager 도입 전까지).
# 아래 POSTGRES_*와 같은 값을 넣는다.
AIRFLOW_VAR_POSTGRES_HOST=
AIRFLOW_VAR_POSTGRES_PORT=
AIRFLOW_VAR_POSTGRES_DB=
AIRFLOW_VAR_POSTGRES_USER=
AIRFLOW_VAR_POSTGRES_PASSWORD=
# data_quality_audit(#295)의 audit-gold task가 driver_env로 넘기는 값 — 위
# AIRFLOW_VAR_POSTGRES_*를 함께 쓴다. GX Data Docs를 올릴 S3 버킷. 비워두면
# batch-jobs 쪽 기본값(de4-data-quality-docs)을 쓴다.
AIRFLOW_VAR_GOLD_AUDIT_S3_BUCKET=
# DAG 실행 결과 Slack 알림(#409). Bot Token 기반 Slack App이 필요하다(Incoming
# Webhook이 아니다 — 담당자 이메일 -> Slack 멘션 변환에 Slack Web API 호출이
# 필요해서다). 필요 스코프: chat:write, users:read.email.
# 형식: slack://:xoxb-<bot-token>@ (Airflow의 URI 기반 env-var connection 규약)
AIRFLOW_CONN_SLACK_API_DEFAULT=
AIRFLOW_VAR_SLACK_ALERT_CHANNEL=
# EMR Serverless Job Run 로그를 영구 저장할 S3 버킷. 비우면 dags/emr_serverless.py
# 기본값(s3://de4-observability-473551908409-ap-northeast-2-an/emr-serverless/logs/)을 쓴다.
AIRFLOW_VAR_EMR_SERVERLESS_LOG_S3_URI=
# on_failure_callback이 실패마다 구조화된 JSON 기록을 남기는 관측 버킷. 비우면
# dags/notifications.py 기본값(s3://de4-observability-473551908409-ap-northeast-2-an/airflow/failed-tasks/,
# 사용자가 사전에 만들어 둔 버킷)을 쓴다.
AIRFLOW_VAR_OBSERVABILITY_FAILED_TASKS_S3_URI=
# DAG Run/Task Instance Slack 알림 링크가 이 값을 기준으로 생성된다. 로컬
# 기본값은 http://localhost:8080 — 운영(EC2)에서는 실제 접속 URL로 채운다.
AIRFLOW_API_BASE_URL=
# zone_weather_pipeline이 zone_master.parquet을, current 점수 재계산이 segment -> zone
# 매핑(road_segment)을 읽을 URI(#400). 비우면 airflow.yaml이 로컬 기본 경로를 채운다.
# 운영에서는 reference S3 URI를 넣는다(local path/file://도 지원).
# ZONE_MASTER_URI=s3://<reference-bucket>/normalized/zone_master/zone_master.parquet
# CURRENT_SCORE_ROAD_SEGMENT_URI=s3://<reference-bucket>/normalized/road_segment
ZONE_MASTER_URI=
CURRENT_SCORE_ROAD_SEGMENT_URI=
CURRENT_SCORE_ROAD_SNAPSHOT_DATE=
# zone_weather_pipeline이 15분마다 zone_weather_snapshot(Bronze) 이력을 쓰고,
# bronze_compaction이 같은 root를 압축 대상으로 읽는 URI(#400). 두 키는 항상 같은
# 값을 가리켜야 한다. 비우면 airflow.yaml이 로컬 기본 경로를 채운다. 운영 Data Lake
# 계약상 zone_weather_snapshot은 Silver가 아니라 Bronze다.
# ZONE_WEATHER_SNAPSHOT_DATA_LAKE_URI=s3://<data-lake-bucket>/bronze/weather-snapshots
# BRONZE_COMPACTION_ZONE_WEATHER_SNAPSHOT_URI=s3://<data-lake-bucket>/bronze/weather-snapshots
ZONE_WEATHER_SNAPSHOT_DATA_LAKE_URI=
BRONZE_COMPACTION_ZONE_WEATHER_SNAPSHOT_URI=
HOURLY_COMFORT_RUN_ID=
DB_MIGRATIONS_DIR=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
AIRFLOW_HOME=
# 비우면 로컬 기본값(postgres:5432, infra/compose/airflow.yaml 참고)을 쓴다.
# EC2 배포에서는 orchestration.env에 실제 RDS 호스트/포트를 채운다.
AIRFLOW_POSTGRES_HOST=
AIRFLOW_POSTGRES_PORT=
AIRFLOW_POSTGRES_DB=
AIRFLOW_POSTGRES_USER=
AIRFLOW_POSTGRES_PASSWORD=
AIRFLOW_JWT_SECRET=
# webserver/scheduler/dag-processor가 공유해야 하는 로그 서버 서명 키.
# 다르면 웹 UI에서 task 로그를 못 가져온다. openssl rand -hex 32로 생성 가능.
AIRFLOW_SECRET_KEY=
CENSUS_API_KEY=
