# Project EC2의 private IPv4 주소. Prometheus 컨테이너 안에서
# project-ec2 hostname을 이 IP로 매핑해 node_exporter/cAdvisor를 scrape한다.
PROJECT_EC2_PRIVATE_IP=

# Spark Streaming EC2의 private IPv4 주소. stream-processor metrics만
# spark-ec2 hostname을 통해 별도로 scrape한다.
SPARK_EC2_PRIVATE_IP=

# Grafana admin 계정. 실제 값은 .env에만 설정하고 커밋하지 않는다.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Slack Bot Token(xoxb-...)/채널. ops-agent(직접 slack_sdk 호출, Airflow의 slack_api_default와 별개)와
# Grafana의 최초 장애 알림 contact point(#447)가 같은 값을 재사용한다.
OPS_AGENT_SLACK_BOT_TOKEN=
OPS_AGENT_SLACK_ALERT_CHANNEL=

# stream-processor restart용 SSH 대상. architecture.md와 deploy-stream-processor.yml의 EC2 설명이 어긋나 기본값을 두지 않았다(#447).
STREAM_PROCESSOR_SSH_HOST=
STREAM_PROCESSOR_SSH_USER=ec2-user

# 위 host 접속용 개인키를 Monitoring EC2의 아래 경로에 직접 준비한다(커밋 안 됨 — .gitignore의 *.pem).
#   infra/monitoring/ops-agent/stream_processor.pem

# serving-api / node-exporter restart용 SSH 대상(Project EC2, #547).
PROJECT_SSH_HOST=
PROJECT_SSH_USER=ec2-user

# 위 host 접속용 개인키를 Monitoring EC2의 아래 경로에 직접 준비한다(커밋 안 됨).
#   infra/monitoring/ops-agent/project.pem
