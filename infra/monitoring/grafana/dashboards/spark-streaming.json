{
  "id": null,
  "uid": "spark-streaming",
  "title": "Spark Streaming",
  "tags": ["stream-processor", "spark", "monitoring"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Target Status",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 1, "w": 24, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "expr": "up{job=\"stream-processor\"}",
          "legendFormat": "{{job}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red", "index": 0 },
                "1": { "text": "UP", "color": "green", "index": 1 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Query Running",
      "description": "stream_processor_query_running — 리스너의 onQueryStarted/onQueryTerminated로 갱신된다.",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "expr": "stream_processor_query_running{job=\"stream-processor\"}",
          "legendFormat": "query running",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "STOPPED", "color": "red", "index": 0 },
                "1": { "text": "RUNNING", "color": "green", "index": 1 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 101,
      "type": "row",
      "title": "Throughput",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 9, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Input Rows/sec",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 10, "w": 12, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "expr": "stream_processor_input_rows_per_second{job=\"stream-processor\"}",
          "legendFormat": "input rows/sec",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "rps"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Processed Rows/sec",
      "datasource": "Prometheus",
      "gridPos": { "x": 12, "y": 10, "w": 12, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "expr": "stream_processor_processed_rows_per_second{job=\"stream-processor\"}",
          "legendFormat": "processed rows/sec",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "rps"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Rows/sec over Time",
      "description": "Kafka에서 읽어들인 input rows/sec와 실제로 처리를 마친 processed rows/sec를 함께 본다.",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "expr": "stream_processor_input_rows_per_second{job=\"stream-processor\"}",
          "legendFormat": "input rows/sec"
        },
        {
          "refId": "B",
          "datasource": "Prometheus",
          "expr": "stream_processor_processed_rows_per_second{job=\"stream-processor\"}",
          "legendFormat": "processed rows/sec"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rps"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 102,
      "type": "row",
      "title": "Batch Health",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 22, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Micro-batch Duration",
      "description": "stream_processor_batch_duration_seconds — durationMs.triggerExecution 기준 마이크로배치 전체 소요 시간.",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 23, "w": 24, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(stream_processor_batch_duration_seconds_bucket{job=\"stream-processor\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(stream_processor_batch_duration_seconds_bucket{job=\"stream-processor\"}[5m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Last Progress Age",
      "description": "마지막 onQueryProgress 이후 경과 시간. STREAM_MAX_TRIGGER_DELAY(기본 5m) 동안은 새 데이터가 없어도 정상적으로 값이 쌓일 수 있다. stream_processor_last_progress_timestamp_seconds는 progress가 한 번도 없으면 0(gauge 초기값)이라, time()과 그대로 빼면 Unix epoch(1970-01-01) 기준 나이인 수십 년짜리 값이 나온다 — timestamp가 0보다 클 때만(즉 실제 progress가 한 번이라도 있었을 때만) age를 계산하도록 and로 걸러 초기 상태에서는 No data(아직 progress 없음, 장애 아님)를 보여준다.",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 31, "w": 24, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "expr": "(time() - stream_processor_last_progress_timestamp_seconds{job=\"stream-processor\"}) and (stream_processor_last_progress_timestamp_seconds{job=\"stream-processor\"} > 0)",
          "legendFormat": "age",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 60 },
              { "color": "red", "value": 330 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 103,
      "type": "row",
      "title": "Totals",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 35, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Total Input Rows",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 36, "w": 12, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "expr": "stream_processor_input_rows_total{job=\"stream-processor\"}",
          "legendFormat": "input rows",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Query Failures",
      "description": "stream_processor_query_failures_total — 컨테이너가 재시작되지 않고 예외로 종료된 누적 횟수.",
      "datasource": "Prometheus",
      "gridPos": { "x": 12, "y": 36, "w": 12, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "expr": "stream_processor_query_failures_total{job=\"stream-processor\"}",
          "legendFormat": "failures",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    }
  ]
}
