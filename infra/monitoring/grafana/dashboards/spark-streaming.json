      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Component Status",
      "description": "우선순위로 판정한다(#437): TARGET DOWN(4, up==0) > QUERY STOPPED(3, 컨테이너는 떠 있는데 streaming query가 안 돎) > PROGRESS STALE(2, 마지막 micro-batch 이후 330초 초과 — Last Progress Age와 같은 threshold) > EVENT DATA STALE(1, 처리 중인 데이터 자체의 event_time이 330초 초과 지연 — Event-Time Lag와 같은 threshold) > RUNNING(0). Kafka Offset Lag는 정상 범위 기준이 없어(해당 패널 설명 참고) 이 판정에서 뺐다.",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 1, "w": 24, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "expr": "(4 * (up{job=\"stream-processor\"} == bool 0) > 0) or (3 * (stream_processor_query_running{job=\"stream-processor\"} == bool 0) > 0) or (2 * (((time() - stream_processor_last_progress_timestamp_seconds{job=\"stream-processor\"}) and (stream_processor_last_progress_timestamp_seconds{job=\"stream-processor\"} > 0)) > bool 330) > 0) or (1 * (stream_processor_event_time_lag_seconds{job=\"stream-processor\"} > bool 330) > 0) or (0 * up{job=\"stream-processor\"})",
          "legendFormat": "{{instance}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "RUNNING", "color": "green", "index": 0 },
                "1": { "text": "EVENT DATA STALE", "color": "orange", "index": 1 },
                "2": { "text": "PROGRESS STALE", "color": "orange", "index": 2 },
                "3": { "text": "QUERY STOPPED", "color": "red", "index": 3 },
                "4": { "text": "TARGET DOWN", "color": "red", "index": 4 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 20,
      "type": "state-timeline",
      "title": "Component Status Timeline",
      "description": "위 Component Status와 완전히 같은 query — 상태 변화 시점을 시간축으로 본다.",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 6 },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "expr": "(4 * (up{job=\"stream-processor\"} == bool 0) > 0) or (3 * (stream_processor_query_running{job=\"stream-processor\"} == bool 0) > 0) or (2 * (((time() - stream_processor_last_progress_timestamp_seconds{job=\"stream-processor\"}) and (stream_processor_last_progress_timestamp_seconds{job=\"stream-processor\"} > 0)) > bool 330) > 0) or (1 * (stream_processor_event_time_lag_seconds{job=\"stream-processor\"} > bool 330) > 0) or (0 * up{job=\"stream-processor\"})",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": { "lineWidth": 1, "fillOpacity": 90 },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "RUNNING", "color": "green", "index": 0 },
                "1": { "text": "EVENT DATA STALE", "color": "orange", "index": 1 },
                "2": { "text": "PROGRESS STALE", "color": "orange", "index": 2 },
                "3": { "text": "QUERY STOPPED", "color": "red", "index": 3 },
                "4": { "text": "TARGET DOWN", "color": "red", "index": 4 }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "always",
        "rowHeight": 0.8,
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
