        "defaults": {
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Freshness over Time",
      "description": "Last Progress Age/Event-Time Lag와 같은 query를 시간축(range query)으로 합쳤다 — 둘 다 초 단위고 같은 330초 threshold를 쓰므로 한 그래프에 같이 둔다(Kafka Offset Lag는 단위가 달라 별도 패널). 예전엔 순간값(stat)+게이지만 있었는데, 330초 threshold에 서서히 가까워지는지 추세로 미리 볼 수 있게 그래프를 추가했다.",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 45, "w": 24, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "expr": "(time() - stream_processor_last_progress_timestamp_seconds{job=\"stream-processor\"}) and (stream_processor_last_progress_timestamp_seconds{job=\"stream-processor\"} > 0)",
          "legendFormat": "Last Progress Age"
        },
        {
          "refId": "B",
          "datasource": "Prometheus",
          "expr": "stream_processor_event_time_lag_seconds{job=\"stream-processor\"}",
          "legendFormat": "Event-Time Lag"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
