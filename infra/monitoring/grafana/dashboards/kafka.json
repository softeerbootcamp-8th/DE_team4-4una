{
  "id": null,
  "uid": "kafka",
  "title": "Kafka",
  "tags": ["kafka", "monitoring"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Target Status",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 1, "w": 24, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "expr": "up{job=\"kafka\"}",
          "legendFormat": "{{job}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red", "index": 0 },
                "1": { "text": "UP", "color": "green", "index": 1 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Brokers",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 5, "w": 6, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "expr": "kafka_brokers{job=\"kafka\"}",
          "legendFormat": "brokers",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Topics",
      "description": "내부 토픽(`__`로 시작, 예: __consumer_offsets)은 제외한다 — 실제로 운영하는 토픽 수를 보기 위함이다.",
      "datasource": "Prometheus",
      "gridPos": { "x": 6, "y": 5, "w": 6, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "expr": "count(kafka_topic_partitions{job=\"kafka\", topic!~\"__.*\"})",
          "legendFormat": "topics",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Partitions",
      "description": "내부 토픽(`__`로 시작, 예: __consumer_offsets)은 제외한다.",
      "datasource": "Prometheus",
      "gridPos": { "x": 12, "y": 5, "w": 6, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "expr": "sum(kafka_topic_partitions{job=\"kafka\", topic!~\"__.*\"})",
          "legendFormat": "partitions",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Under Replicated",
      "description": "내부 토픽을 포함한 전체 클러스터 건강 신호다(Topics/Partitions 패널과 달리 제외하지 않음). 0이 정상이다.",
      "datasource": "Prometheus",
      "gridPos": { "x": 18, "y": 5, "w": 6, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "expr": "sum(kafka_topic_partition_under_replicated_partition{job=\"kafka\"})",
          "legendFormat": "under-replicated",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Message Rate over Time (offset increase, approx.)",
      "description": "kafka_topic_partition_current_offset의 증가율로 근사한 topic별 message rate다. Kafka broker의 byte throughput(Bytes In/Out) JMX metric이 아니다 — 이번 작업 범위에서 제외했다. 내부 토픽은 제외한다.",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 13, "w": 24, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "expr": "sum by (topic) (rate(kafka_topic_partition_current_offset{job=\"kafka\", topic!~\"__.*\"}[5m]))",
          "legendFormat": "{{topic}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 101,
      "type": "row",
      "title": "Consumers",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 21, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Consumer Lag",
      "description": "consumer group이 아직 하나도 없으면 kafka_consumergroup_lag 자체가 없어 이 패널은 No data다 — 장애가 아니다. README의 Troubleshooting 참고.",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 22, "w": 24, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "expr": "sum(kafka_consumergroup_lag{job=\"kafka\"})",
          "legendFormat": "lag",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Consumer Lag by Topic",
      "description": "kafka_consumergroup_lag_sum(모든 partition 합산)을 topic별로 더한다. consumer group이 없으면 No data다.",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 26, "w": 24, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "expr": "sum by (topic) (kafka_consumergroup_lag_sum{job=\"kafka\"})",
          "legendFormat": "{{topic}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Consumer Group Members",
      "description": "consumer group이 없으면 No data다.",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 34, "w": 24, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "expr": "sum by (consumergroup) (kafka_consumergroup_members{job=\"kafka\"})",
          "legendFormat": "{{consumergroup}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    }
  ]
}
