    {
      "id": 1,
      "type": "stat",
      "title": "Running Jobs",
      "description": "AWS/EMRServerless RunningJobs (Statistic: Maximum).",
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
      "gridPos": { "x": 0, "y": 1, "w": 8, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
          "namespace": "AWS/EMRServerless",
          "metricName": "RunningJobs",
          "dimensions": { "ApplicationId": "$application_id", "ApplicationName": "$application_name" },
          "statistic": "Maximum",
          "region": "default",
          "matchExact": false,
          "id": "runningJobs",
          "hide": true
        },
        {
          "refId": "B",
          "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
          "expression": "SUM(runningJobs)",
          "id": "runningJobsTotal",
          "region": "default"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
