    {
      "id": 102,
      "type": "row",
      "title": "Task Result",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Task Success Rate",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 15, "w": 12, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "expr": "sum(rate(airflow_ti_successes{job=\"airflow\"}[5m]))",
          "legendFormat": "successes/sec",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": { "unit": "ops", "color": { "fixedColor": "green", "mode": "fixed" } },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Task Failure Rate",
      "datasource": "Prometheus",
      "gridPos": { "x": 12, "y": 15, "w": 12, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "expr": "sum(rate(airflow_ti_failures{job=\"airflow\"}[5m]))",
          "legendFormat": "failures/sec",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": { "unit": "ops", "color": { "fixedColor": "red", "mode": "fixed" } },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Failures by DAG",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 19, "w": 24, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "expr": "sum by (dag_id) (rate(airflow_ti_failures{job=\"airflow\"}[5m]))",
          "legendFormat": "{{dag_id}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Failures by Task",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 27, "w": 24, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "expr": "sum by (dag_id, task_id) (rate(airflow_ti_failures{job=\"airflow\"}[5m]))",
          "legendFormat": "{{dag_id}}/{{task_id}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 103,
      "type": "row",
      "title": "Duration",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 35, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Task Duration",
      "description": "airflow_task_duration_seconds는 statsd/airflow-mapping.yml로 histogram으로 바꾼 metric이다(기본값은 Summary라 p95를 못 구함). Airflow는 StatsD timer(|ms)로 보내지만 statsd_exporter가 노출 시 seconds로 자동 변환한다.",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 36, "w": 24, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(airflow_task_duration_seconds_bucket{job=\"airflow\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(airflow_task_duration_seconds_bucket{job=\"airflow\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(airflow_task_duration_seconds_bucket{job=\"airflow\"}[5m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "DAG Run Success Duration",
      "description": "성공한 DAG run의 소요 시간(p50/p95/p99). 단위는 seconds.",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 44, "w": 24, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(airflow_dagrun_duration_success_seconds_bucket{job=\"airflow\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(airflow_dagrun_duration_success_seconds_bucket{job=\"airflow\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(airflow_dagrun_duration_success_seconds_bucket{job=\"airflow\"}[5m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "DAG Run Failed Duration",
      "description": "실패한 DAG run의 소요 시간(p50/p95/p99). 단위는 seconds.",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 52, "w": 24, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(airflow_dagrun_duration_failed_seconds_bucket{job=\"airflow\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
