{
  "id": null,
  "uid": "airflow",
  "title": "Airflow",
  "tags": ["airflow", "monitoring"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Target Status",
      "description": "statsd_exporter가 살아있는지만 본다. scheduler/dag-processor가 실제로 metric을 보내는지는 아래 Heartbeat 패널로 확인한다.",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 1, "w": 24, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "expr": "up{job=\"airflow\"}",
          "legendFormat": "{{job}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red", "index": 0 },
                "1": { "text": "UP", "color": "green", "index": 1 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Scheduler Heartbeat",
      "description": "최근 5분간 scheduler_heartbeat 증가량. 0이면 scheduler가 metric을 안 보내고 있다는 뜻 — 컨테이너가 죽었거나 exporter로 가는 UDP가 막혔을 수 있다.",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 5, "w": 8, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "expr": "sum(increase(airflow_scheduler_heartbeat{job=\"airflow\"}[5m]))",
          "legendFormat": "heartbeats",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "DAG Processor Heartbeat",
      "description": "최근 5분간 dag_processor_heartbeat 증가량. 0이면 dag-processor가 죽었거나 metric이 안 오고 있다는 뜻이다.",
      "datasource": "Prometheus",
      "gridPos": { "x": 8, "y": 5, "w": 8, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "expr": "sum(increase(airflow_dag_processor_heartbeat{job=\"airflow\"}[5m]))",
          "legendFormat": "heartbeats",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "DAG Import Errors",
      "description": "0이 정상이다. DAG 파일이 파싱 에러가 있으면 dag-processor가 이 값을 올린다.",
      "datasource": "Prometheus",
      "gridPos": { "x": 16, "y": 5, "w": 8, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "expr": "airflow_dag_processing_import_errors{job=\"airflow\"}",
          "legendFormat": "import errors",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 101,
      "type": "row",
      "title": "DAG / Task State",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 9, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Running DAG Runs",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 10, "w": 6, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "expr": "sum(airflow_scheduler_dagruns_running{job=\"airflow\"})",
          "legendFormat": "running dagruns",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] }
    },
    {
