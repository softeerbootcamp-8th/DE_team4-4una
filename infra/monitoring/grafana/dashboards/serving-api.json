    {
      "id": 100,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Component Status",
      "description": "HEALTHY(0)/TARGET DOWN(1, up==0) 2단계뿐이다(#437) — HIGH 5XX/HIGH LATENCY는 정상 범위에 대한 확립된 SLA/threshold가 이 프로젝트에 아직 없어서(5xx/p95 latency 패널 모두 threshold 미설정) 임의로 만들지 않았다. 실제 운영 기준이 생기면 이 판정에 추가한다.",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 1, "w": 24, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "expr": "(1 * (up{job=\"serving-api\"} == bool 0) > 0) or (0 * up{job=\"serving-api\"})",
          "legendFormat": "{{instance}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "HEALTHY", "color": "green", "index": 0 },
                "1": { "text": "TARGET DOWN", "color": "red", "index": 1 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "state-timeline",
      "title": "Component Status Timeline",
      "description": "위 Component Status와 완전히 같은 query — 상태 변화 시점을 시간축으로 본다.",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 6 },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "expr": "(1 * (up{job=\"serving-api\"} == bool 0) > 0) or (0 * up{job=\"serving-api\"})",
