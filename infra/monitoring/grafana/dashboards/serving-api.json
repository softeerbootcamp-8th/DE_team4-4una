    {
      "id": 13,
      "type": "timeseries",
      "title": "Latency over Time (p50/p95/p99)",
      "description": "아래 p50/p95/p99 latency stat 패널과 같은 query를 시간축(range query)으로 합쳤다 — 순간값 3개만으로는 안 보이는 추세(지연이 서서히 늘어나는 중인지)를 여기서 본다.",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 28, "w": 24, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(serving_api_http_request_duration_seconds_bucket{job=\"serving-api\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(serving_api_http_request_duration_seconds_bucket{job=\"serving-api\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(serving_api_http_request_duration_seconds_bucket{job=\"serving-api\"}[5m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
