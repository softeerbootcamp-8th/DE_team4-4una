      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "expr": "up{job=~\"project-node|project-containers\"}",
          "legendFormat": "{{job}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "value_and_name",
