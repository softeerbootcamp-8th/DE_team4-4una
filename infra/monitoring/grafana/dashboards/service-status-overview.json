    {
      "id": 6,
      "type": "stat",
      "title": "EMR Serverless",
      "description": "AWS/EMRServerless RunningJobs (Statistic: Maximum) 직접 조회 — emr-serverless.json의 Running Jobs 패널과 동일한 direct query(queryMode/metricQueryType/metricEditorMode/matchExact:true)로 맞췄다(#410). 이전에는 hidden target + SUM() Metric Math 구성이라 두 target이 기본값(Search, Code)으로 해석돼 No data였다. RunningJobs=0은 실행 중인 job이 없는 정상 idle 상태이므로 IDLE(파랑)로 표시하고 DOWN(빨강)으로 취급하지 않는다. 6시간 창 안에 metric 자체가 전혀 없으면(잘못된 Application ID/Name, IAM 권한 문제, 또는 오래 idle이라 auto-stop된 상태 포함) NO METRIC DATA(주황)로 표시한다 — 실제 상태는 `aws emr-serverless get-application --application-id $application_id`로 확인해야 한다.",
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
      "timeFrom": "6h",
      "gridPos": { "x": 20, "y": 6, "w": 4, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "namespace": "AWS/EMRServerless",
          "metricName": "RunningJobs",
          "dimensions": { "ApplicationId": "$application_id", "ApplicationName": "$application_name" },
          "statistic": "Maximum",
          "region": "default",
          "matchExact": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "NO METRIC DATA",
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": { "text": "NO METRIC DATA", "color": "orange", "index": 0 }
              }
            },
            {
              "type": "value",
              "options": {
                "0": { "text": "IDLE", "color": "blue", "index": 1 }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 1,
                "to": 1000000,
                "result": { "text": "RUNNING", "color": "green", "index": 2 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "orange", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "links": [
        { "title": "EMR Serverless", "url": "/d/emr-serverless?from=${__from}&to=${__to}", "targetBlank": false }
      ]
    },
